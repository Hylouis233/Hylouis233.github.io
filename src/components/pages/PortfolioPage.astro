---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
import { projects, type ProjectType } from '../../data/academic';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const ui = {
  en: {
    pageTitle: `${profile.name.en} | Portfolio`,
    introEyebrow: 'Portfolio overview',
    introTitle: 'Research software and analytical systems',
    introLede:
      'Research software, analytical pipelines, and supporting systems connected to forecasting, outbreak modelling, data engineering, and bibliographic workflows.',
    coverageNote:
      'The portfolio foregrounds featured systems first, then moves into supporting infrastructure.',
    statFeatured: 'Featured systems',
    statRepos: 'Public repositories',
    statTotal: 'Tracked project records',
    statStars: 'Cumulative stars',
    featuredEyebrow: 'Systems',
    featuredTitle: 'Featured research systems',
    featuredSubtitle:
      'These systems are the research software that supports the published work.',
    problemLabel: 'Problem',
    outputLabel: 'Output',
    methodsLabel: 'Methods',
    openRepo: 'Open repository',
    noRepo: 'No public repository link',
    relatedPrefix: 'Related output: ',
    supportingEyebrow: 'Infrastructure',
    supportingTitle: 'Tools and supporting infrastructure',
    supportingSubtitle:
      'Supporting tools and repositories extend the research stack without being presented as separate polished demos.',
    capabilityEyebrow: 'Capabilities',
    capabilityTitle: 'Methods at a glance',
    capabilitySubtitle:
      'The current portfolio emphasizes methods, systems, and outputs rather than screenshots or interactive demos.',
    capabilityCards: [
      {
        title: 'Forecasting',
        body: 'Multimodal prediction, early-warning framing, decomposition-based workflows, and respiratory disease signal modelling.',
      },
      {
        title: 'Mechanistic modelling',
        body: 'ODE and Petri Net outbreak analysis with intervention-oriented interpretation under small-sample conditions.',
      },
      {
        title: 'Data systems',
        body: 'Crawler pipelines, ETL, database workflows, visualization support, and research-oriented monitoring infrastructure.',
      },
      {
        title: 'Research tooling',
        body: 'Bibliographic validation, metadata normalization, and support tooling for evidence-driven writing workflows.',
      },
    ],
    statsEyebrow: 'Activity',
    statsTitle: 'Recently I am',
    statsSubtitle: 'Live GitHub activity, pinned research repositories, and the day-to-day research stack.',
    statsHeadings: {
      repositories: 'Featured Research Repositories',
      techStack: 'Tech Stack',
      activityGraph: 'Live Activity Graph',
      snake: 'Contribution Snake',
      threeD: '3D Contribution Profile',
      metricsGallery: 'Metrics Gallery',
      researchStack: 'Research Stack',
      academicProfiles: 'Academic Profiles',
    },
    statsAlts: {
      metricsBase: 'GitHub metrics overview',
      metricsLanguages: 'Programming language metrics',
      trophies: 'GitHub trophies',
      streak: 'GitHub contribution streak',
      pinnedRepos: 'Pinned repository metrics',
      activityGraph: 'Live GitHub activity graph',
      snake: 'GitHub contribution snake',
      threeD: '3D contribution profile',
    },
  },
  zh: {
    pageTitle: `${profile.name.zh} | 项目作品`,
    introEyebrow: '项目概览',
    introTitle: '研究软件与分析系统',
    introLede: '这里呈现与预测预警、疫情建模、数据工程及文献工作流相关的研究软件、分析管线与支撑系统。',
    coverageNote: '本页首先呈现重点系统，随后依次展开支撑性基础设施、能力框架与实现边界。',
    statFeatured: '重点系统',
    statRepos: '公开仓库',
    statTotal: '在册项目记录',
    statStars: '累计 Star',
    featuredEyebrow: '研究系统',
    featuredTitle: '重点研究系统',
    featuredSubtitle: '支撑上述研究的代表性软件系统与方法组件。',
    problemLabel: '研究问题',
    outputLabel: '研究产出',
    methodsLabel: '方法工具',
    openRepo: '查看仓库',
    noRepo: '暂无公开仓库链接',
    relatedPrefix: '相关成果：',
    supportingEyebrow: '基础设施',
    supportingTitle: '工具与支撑性基础设施',
    supportingSubtitle: '支撑性工具与仓库拓展了研究技术栈，但不作为独立的完整演示呈现。',
    capabilityEyebrow: '研究方法概览',
    capabilityTitle: '研究方法概览',
    capabilitySubtitle: '支撑上述研究的方法、系统与产出。',
    capabilityCards: [
      {
        title: '预测预警',
        body: '多模态预测、预警框架设计、基于分解的工作流与呼吸道疾病信号建模。',
      },
      {
        title: '机制建模',
        body: '基于 ODE 与 Petri Net 的疫情分析，面向数据有限条件开展干预导向的结果解释。',
      },
      {
        title: '数据系统',
        body: '爬虫管线、ETL、数据库工作流、可视化支持与面向科研的监测基础设施。',
      },
      {
        title: '科研工具',
        body: '文献校验、元数据规范化，以及支撑循证写作流程的辅助工具。',
      },
    ],
    statsEyebrow: '动态',
    statsTitle: '近期动态',
    statsSubtitle: 'GitHub 实时动态、重点研究仓库与日常研究技术栈。',
    statsHeadings: {
      repositories: '重点研究仓库',
      techStack: '技术栈',
      activityGraph: '实时活动图',
      snake: '贡献贪吃蛇',
      threeD: '3D 贡献档案',
      metricsGallery: '指标图集',
      researchStack: '研究工具链',
      academicProfiles: '学术档案',
    },
    statsAlts: {
      metricsBase: 'GitHub 指标概览图',
      metricsLanguages: '编程语言统计图',
      trophies: 'GitHub 奖杯墙',
      streak: 'GitHub 连续贡献统计图',
      pinnedRepos: '置顶仓库指标图',
      activityGraph: 'GitHub 实时活动图',
      snake: 'GitHub 贡献贪吃蛇图',
      threeD: 'GitHub 3D 贡献档案图',
    },
  },
} as const;

const copy = ui[lang];

const typeLabels: Record<ProjectType, { en: string; zh: string }> = {
  software: { en: 'Software', zh: '软件' },
  platform: { en: 'Platform', zh: '平台' },
  'research-code': { en: 'Research code', zh: '研究代码' },
  'analysis-project': { en: 'Analysis project', zh: '分析项目' },
};

const featuredProjects = projects.filter((item) => item.featured);
const supportingProjects = projects.filter((item) => !item.featured);

const statCards = [
  { value: featuredProjects.length, label: copy.statFeatured },
  { value: projects.filter((item) => item.repoUrl).length, label: copy.statRepos },
  { value: projects.length, label: copy.statTotal },
];

const totalStars = projects.reduce((acc, item) => acc + (item.stars || 0), 0);

const cardIndex = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout title={copy.pageTitle} lang={lang}>
  <div class="portfolio-page" data-lang={lang}>
    <header class="page-intro">
      <p class="eyebrow">{copy.introEyebrow}</p>
      <h2 class="page-title">{copy.introTitle}</h2>
      <p class="page-lede">{copy.introLede}</p>
      <div class="coverage-grid">
        {[...statCards, { value: totalStars, label: copy.statStars }].map((card) => (
          <article class="coverage-card">
            <p class="coverage-value">{card.value}</p>
            <p class="coverage-label">{card.label}</p>
          </article>
        ))}
      </div>
      <p class="coverage-note">{copy.coverageNote}</p>
    </header>

    <section class="page-section" aria-labelledby="portfolio-featured-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.featuredEyebrow}</p>
        <h2 class="section-title" id="portfolio-featured-title">{copy.featuredTitle}</h2>
        <p class="section-subtitle">{copy.featuredSubtitle}</p>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((item) => (
          <article class="featured-card">
            <div class="featured-head">
              <p class="item-kicker">{t(typeLabels[item.type], lang)}</p>
              <h3>{t(item.name, lang)}</h3>
            </div>
            <div class="featured-rows">
              <div class="featured-row">
                <p class="meta-label">{copy.problemLabel}</p>
                <p>{t(item.summary, lang)}</p>
              </div>
              {item.impactSummary && (
                <div class="featured-row">
                  <p class="meta-label">{copy.outputLabel}</p>
                  <p>{t(item.impactSummary, lang)}</p>
                </div>
              )}
              {item.tags && (
                <div class="featured-row">
                  <p class="meta-label">{copy.methodsLabel}</p>
                  <div class="chip-row">
                    {item.tags.map((tag) => (
                      <span class="chip">{tag}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <div class="featured-foot">
              {item.repoUrl ? (
                <a class="repo-link" href={item.repoUrl} target="_blank" rel="noreferrer">{copy.openRepo}</a>
              ) : (
                <span class="foot-meta">{copy.noRepo}</span>
              )}
              {item.stars ? <span class="foot-meta repo-stars" aria-label={`${item.stars} stars on GitHub`}>★ {item.stars}</span> : null}
              {item.relatedPublicationTitles?.map((title) => (
                <span class="foot-meta">{copy.relatedPrefix}{title}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section" aria-labelledby="portfolio-supporting-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.supportingEyebrow}</p>
        <h2 class="section-title" id="portfolio-supporting-title">{copy.supportingTitle}</h2>
        <p class="section-subtitle">{copy.supportingSubtitle}</p>
      </div>
      <div class="supporting-grid">
        {supportingProjects.map((item) => (
          <article class="support-card">
            <p class="item-kicker">{t(typeLabels[item.type], lang)}</p>
            <h3>{t(item.name, lang)}</h3>
            <p>{t(item.summary, lang)}</p>
            {item.tags && (
              <div class="chip-row">
                {item.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
                {item.stars ? <span class="chip chip-stars" aria-label={`${item.stars} stars on GitHub`}>★ {item.stars}</span> : null}
              </div>
            )}
            {(!item.tags && item.stars) ? (
              <div class="chip-row">
                <span class="chip chip-stars" aria-label={`${item.stars} stars on GitHub`}>★ {item.stars}</span>
              </div>
            ) : null}
          </article>
        ))}
      </div>
    </section>

    <section class="page-section" aria-labelledby="portfolio-capability-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.capabilityEyebrow}</p>
        <h2 class="section-title" id="portfolio-capability-title">{copy.capabilityTitle}</h2>
        <p class="section-subtitle">{copy.capabilitySubtitle}</p>
      </div>
      <div class="capability-grid">
        {copy.capabilityCards.map((card, i) => (
          <article class="capability-card">
            <span class="capability-index" aria-hidden="true">{cardIndex(i)}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section" aria-labelledby="portfolio-stats-title">
      <div class="section-heading">
        <p class="eyebrow">{copy.statsEyebrow}</p>
        <h2 class="section-title" id="portfolio-stats-title">{copy.statsTitle}</h2>
        <p class="section-subtitle">{copy.statsSubtitle}</p>
      </div>
      <div class="stats-container">
        <div class="stats-badges">
          <a href="https://hylouis233.github.io"><img src="https://img.shields.io/badge/Website-Academic%20Homepage-0f766e?style=flat-square&logo=astro&logoColor=white" alt="Website" /></a>
          <a href="mailto:liuh200107@gmail.com"><img src="https://img.shields.io/badge/Email-liuh200107%40gmail.com-d14836?style=flat-square&logo=gmail&logoColor=white" alt="Email" /></a>
          <a href="mailto:hylouis@qq.com"><img src="https://img.shields.io/badge/QQ%20Mail-hylouis%40qq.com-12b7f5?style=flat-square&logo=tencentqq&logoColor=white" alt="QQ Mail" /></a>
        </div>

        <div class="stats-grid-2">
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/base.svg" alt={copy.statsAlts.metricsBase} />
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/languages.indepth.svg" alt={copy.statsAlts.metricsLanguages} />
        </div>

        <div class="stats-center">
          <img loading="lazy" src="https://trophy.ryglcloud.net/?username=Hylouis233&no-frame=true&no-bg=true&theme=transparent&margin-w=10&margin-h=10" alt={copy.statsAlts.trophies} />
        </div>

        <div class="stats-center">
          <img loading="lazy" src="https://github-readme-streak-stats.herokuapp.com/?user=Hylouis233&theme=transparent&background=transparent&hide_border=true" alt={copy.statsAlts.streak} />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.repositories}</h3>
        <div class="stats-center">
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/repositories.pinned.svg" alt={copy.statsAlts.pinnedRepos} />
          <div class="stats-badges">
            <a href="https://github.com/Hylouis233/phsciencedata_crawler_region"><img src="https://img.shields.io/badge/phsciencedata_crawler_region-Repository-0056b3?style=flat-square&logo=github&logoColor=white" alt="phsciencedata_crawler_region" /></a>
            <a href="https://github.com/Hylouis233/Breteau-Index-Prediction-Model-using-machine-learning"><img src="https://img.shields.io/badge/Breteau_Index_Prediction-Repository-0056b3?style=flat-square&logo=github&logoColor=white" alt="Breteau Index Prediction repository" /></a>
            <a href="https://github.com/Hylouis233/bibverify"><img src="https://img.shields.io/badge/bibverify-Repository-0056b3?style=flat-square&logo=github&logoColor=white" alt="bibverify repository" /></a>
          </div>
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.techStack}</h3>
        <div class="stats-badges">
          <img src="https://img.shields.io/badge/-HTML5-E34F26?style=flat-square&logo=html5&logoColor=white" alt="HTML5" />
          <img src="https://img.shields.io/badge/-CSS3-1572B6?style=flat-square&logo=css3" alt="CSS3" />
          <img src="https://img.shields.io/badge/-JavaScript-F7DF1E?style=flat-square&logo=javascript&logoColor=000" alt="JavaScript" />
          <img src="https://img.shields.io/badge/-Python-3776AB?style=flat-square&logo=python&logoColor=white" alt="Python" />
          <img src="https://img.shields.io/badge/-C++-00599C?style=flat-square&logo=c%2B%2B&logoColor=white" alt="C++" />
        </div>

        <hr class="stats-divider" />

        <h3 class="stats-minor-title">{copy.statsHeadings.activityGraph}</h3>
        <div class="stats-center">
          <img loading="lazy" src="https://github-readme-activity-graph.vercel.app/graph?username=Hylouis233&theme=transparent&hide_border=true&bg_color=transparent" alt={copy.statsAlts.activityGraph} />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.snake}</h3>
        <div class="stats-center">
          <img class="blend-multiply" loading="lazy" alt={copy.statsAlts.snake} src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/profile-snake-contrib/github-contribution-grid-snake.svg" />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.threeD}</h3>
        <div class="stats-center">
          <img class="blend-multiply" loading="lazy" alt={copy.statsAlts.threeD} src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/profile-3d-contrib/profile-gitblock.svg" />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.metricsGallery}</h3>
        <div class="stats-center stats-metrics-stack">
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/base.svg" alt={copy.statsAlts.metricsBase} />
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/languages.indepth.svg" alt={copy.statsAlts.metricsLanguages} />
          <img class="blend-multiply" loading="lazy" src="https://raw.githubusercontent.com/Hylouis233/Hylouis233/main/github-metrics/repositories.pinned.svg" alt={copy.statsAlts.pinnedRepos} />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.researchStack}</h3>
        <div class="stats-badges">
          <img src="https://img.shields.io/badge/Python-Research%20Code-3776AB?style=flat-square&logo=python&logoColor=white" alt="Python" />
          <img src="https://img.shields.io/badge/R-Statistical%20Analysis-276DC3?style=flat-square&logo=r&logoColor=white" alt="R" />
          <img src="https://img.shields.io/badge/Jupyter-Notebook%20Workflows-F37626?style=flat-square&logo=jupyter&logoColor=white" alt="Jupyter" />
          <img src="https://img.shields.io/badge/PyTorch-Deep%20Learning-EE4C2C?style=flat-square&logo=pytorch&logoColor=white" alt="PyTorch" />
          <img src="https://img.shields.io/badge/scikit--learn-Machine%20Learning-F7931E?style=flat-square&logo=scikitlearn&logoColor=white" alt="scikit-learn" />
          <img src="https://img.shields.io/badge/Linux-Research%20Compute-FCC624?style=flat-square&logo=linux&logoColor=000" alt="Linux" />
          <img src="https://img.shields.io/badge/Git-Reproducible%20Workflows-F05032?style=flat-square&logo=git&logoColor=white" alt="Git" />
          <img src="https://img.shields.io/badge/LaTeX-Manuscript%20Writing-008080?style=flat-square&logo=latex&logoColor=white" alt="LaTeX" />
        </div>

        <h3 class="stats-minor-title">{copy.statsHeadings.academicProfiles}</h3>
        <div class="stats-badges">
          <a href="https://hylouis233.github.io"><img src="https://img.shields.io/badge/Website-Academic%20Homepage-0f766e?style=flat-square&logo=astro&logoColor=white" alt="Website" /></a>
          <a href="https://orcid.org/0009-0008-3411-5304"><img src="https://img.shields.io/badge/ORCID-0009--0008--3411--5304-A6CE39?style=flat-square&logo=orcid&logoColor=white" alt="ORCID" /></a>
          <a href="https://scholar.google.com/citations?user=XktvX-gAAAAJ&hl=en&authuser=1"><img src="https://img.shields.io/badge/Google%20Scholar-Profile-4285F4?style=flat-square&logo=googlescholar&logoColor=white" alt="Google Scholar" /></a>
          <a href="https://www.researchgate.net/profile/Hong-Liu-79/publications?sorting=recentlyAdded&editMode=1"><img src="https://img.shields.io/badge/ResearchGate-Publications-00CCBB?style=flat-square&logo=researchgate&logoColor=white" alt="ResearchGate" /></a>
          <a href="https://hylouis233.github.io/files/cv.pdf"><img src="https://img.shields.io/badge/CV-Download-B31B1B?style=flat-square&logo=adobeacrobatreader&logoColor=white" alt="CV" /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-page {
    display: block;
  }

  /* Page intro */
  .page-intro {
    max-width: 780px;
  }
  .page-title {
    margin: 10px 0 14px;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: 0;
  }
  .page-lede {
    margin: 0;
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.8;
  }

  /* Coverage stats */
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .coverage-card {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    box-shadow: var(--shadow-soft);
  }
  .coverage-value {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--accent);
  }
  .coverage-label {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .coverage-note {
    margin: 18px 0 0;
    color: var(--faint);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* Section rhythm */
  .page-section {
    margin-top: 64px;
  }
  .section-heading {
    max-width: 720px;
    margin-bottom: 28px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .section-heading .section-title {
    margin: 10px 0 10px;
  }

  /* Featured systems */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .featured-card {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-soft);
  }
  .featured-head {
    display: grid;
    gap: 6px;
  }
  .featured-head .item-kicker {
    margin: 0;
  }
  .featured-head h3 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  .featured-rows {
    display: grid;
  }
  .featured-row {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 4px 18px;
    align-items: start;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .featured-row .meta-label {
    margin: 3px 0 0;
  }
  .featured-row p {
    margin: 0;
    min-width: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .featured-row .chip-row {
    gap: 6px;
  }
  .featured-foot {
    display: flex;
