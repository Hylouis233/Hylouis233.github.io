---
import { monetizationConfig, type AdPosition, type PageType } from '../data/monetization';

interface Props {
  position: AdPosition;
  pageType?: PageType;
  maxItems?: number;
  class?: string;
}

const {
  position,
  pageType = 'landing',
  maxItems = 1,
  class: className,
} = Astro.props as Props;

const ads = monetizationConfig.ads.enabled
  ? monetizationConfig.ads.creatives
      .filter((creative) =>
        creative.enabled &&
        creative.positions.includes(position) &&
        creative.pageTypes.includes(pageType)
      )
      .slice(0, maxItems)
  : [];
---

{ads.length > 0 && (
  <aside class:list={['ad-slot', `ad-slot-${position}`, className]} aria-label={monetizationConfig.ads.disclosure}>
    {ads.map((creative) => (
      creative.network?.iframeSrc ? (
        <div id={creative.network.containerId} class="ad-slot-network" data-ad-provider={creative.network.provider}>
          <span class="ad-slot-label">{creative.label}</span>
          <div class="aads-frame-wrap">
            <iframe
              data-aa={creative.network.iframeDataAa}
              src={creative.network.iframeSrc}
              title={creative.network.iframeTitle ?? creative.title}
              loading="lazy"
            ></iframe>
          </div>
        </div>
      ) : creative.href ? (
        <a class="ad-slot-card" href={creative.href} rel={creative.rel ?? monetizationConfig.ads.fallbackRel}>
          {creative.imageSrc && (
            <img src={creative.imageSrc} alt={creative.imageAlt ?? creative.title} loading="lazy" />
          )}
          <span class="ad-slot-label">{creative.label}</span>
          <span class="ad-slot-copy">
            <strong>{creative.title}</strong>
            <span>{creative.description}</span>
          </span>
          <span class="ad-slot-cta">{creative.cta}</span>
        </a>
      ) : (
        <div class="ad-slot-card ad-slot-card-static" data-ad-provider={creative.network?.provider}>
          {creative.imageSrc && (
            <img src={creative.imageSrc} alt={creative.imageAlt ?? creative.title} loading="lazy" />
          )}
          <span class="ad-slot-label">{creative.label}</span>
          <span class="ad-slot-copy">
            <strong>{creative.title}</strong>
            <span>{creative.description}</span>
          </span>
          <span class="ad-slot-cta ad-slot-cta-muted">{creative.cta}</span>
        </div>
      )
    ))}
  </aside>
)}

<style>
  .ad-slot {
    margin-top: 28px;
  }

  .ad-slot-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px 18px;
    align-items: center;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(245, 245, 245, 0.62));
    color: var(--text);
    box-shadow: var(--shadow-soft);
  }

  .ad-slot-network {
    display: grid;
    gap: 10px;
    padding: 14px 16px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(245, 245, 245, 0.62));
    box-shadow: var(--shadow-soft);
  }

  .ad-slot-network + .ad-slot-card,
  .ad-slot-card + .ad-slot-network,
  .ad-slot-card + .ad-slot-card {
    margin-top: 14px;
  }

  .aads-frame-wrap {
    width: 100%;
    margin: auto;
    position: relative;
    z-index: 1;
  }

  .aads-frame-wrap iframe {
    width: min(100%, 900px);
    min-height: 120px;
    border: 0;
    padding: 0;
    overflow: hidden;
    display: block;
    margin: auto;
  }

  .ad-slot-card:hover,
  .ad-slot-card:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    outline: none;
  }

  .ad-slot-card-static:hover {
    border-color: var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(245, 245, 245, 0.62));
  }

  .ad-slot-card img {
    grid-row: span 2;
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: #ffffff;
    border: 1px solid var(--line);
  }

  .ad-slot-label {
    grid-column: 1 / -1;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ad-slot-copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .ad-slot-copy strong {
    font-size: 1rem;
    line-height: 1.35;
  }

  .ad-slot-copy span {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 76ch;
  }

  .ad-slot-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 13px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .ad-slot-cta-muted {
    border-color: var(--line);
    background: var(--surface-muted);
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .ad-slot-card {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .ad-slot-card img {
      grid-row: auto;
    }

    .ad-slot-cta {
      justify-self: start;
      white-space: normal;
    }
  }
</style>
