---
import { navigation, profile, siteMeta, iconMap } from '../data/profile';
import { defaultLang, icpText, localizedPath, showIcp, showLangToggle, t, type Lang } from '../i18n';

interface Props {
  title: string;
  lang?: Lang;
}

const { title, lang = defaultLang } = Astro.props as Props;
const portfolioHref = profile.portfolioHref;
const brandSubtitle = { en: 'Academic profile', zh: '学术主页' };
const currentPath = Astro.url.pathname;
const toggleLang: Lang = lang === 'zh' ? 'en' : 'zh';
const toggleHref = localizedPath(currentPath, toggleLang);
const toggleLabel = lang === 'zh' ? 'English' : '中文';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={siteMeta.description} />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <style is:global>
      :root {
        /* Core design tokens */
        --ink: #1c2430;
        --body: #333c49;
        --muted: #64707e;
        --faint: #8a94a1;
        --line: #e4e7ec;
        --line-strong: #d3d8e0;
        --bg: #ffffff;
        --surface: #f7f8fa;
        --surface-raised: #ffffff;
        --accent: #0f4c9b;
        --accent-soft: rgba(15, 76, 155, 0.08);
        --accent-ink: #0b3a78;

        /* Legacy aliases kept for page-level styles */
        --text: var(--ink);
        --muted-soft: var(--faint);
        --surface-strong: var(--surface-raised);
        --surface-muted: #eff1f5;
        --surface-quiet: #e9edf2;
        --gold: var(--accent);
        --shadow: 0 12px 32px rgba(28, 36, 48, 0.07);
        --shadow-soft: 0 4px 14px rgba(28, 36, 48, 0.04);
        --radius-lg: 14px;
        --radius-md: 10px;
        --radius-sm: 6px;
        --measure: 72ch;

        /* Typography */
        --font-serif: "Noto Serif SC", "Source Serif Pro", "Songti SC", Georgia, "Times New Roman", serif;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        font-size: 1rem;
        background: var(--bg);
        color: var(--body);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      h1, h2, h3, h4, h5, h6 {
        margin: 0;
        font-family: var(--font-serif);
        color: var(--ink);
        line-height: 1.35;
        font-weight: 700;
        letter-spacing: 0;
      }
      h1 { font-size: clamp(2.2rem, 4vw, 2.75rem); }
      h2 { font-size: 1.55rem; }
      h3 { font-size: 1.22rem; }
      h4 { font-size: 1.05rem; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      p, li { max-width: var(--measure); }
      .shell { max-width: 1080px; margin: 0 auto; padding: 24px 24px 32px; }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 20px;
        padding: 16px 0 24px;
        border-bottom: 1px solid var(--line-strong);
      }
      .brand h1 {
        margin: 0;
        font-size: 1.3rem;
        letter-spacing: 0.01em;
        font-weight: 700;
      }
      .brand p {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
      }
      .nav a,
      .footer-links a,
      .icon-link {
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        border: 1px solid var(--line);
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      }
      .nav a:hover,
      .footer-links a:hover,
      .icon-link:hover,
      .nav a:focus-visible,
      .footer-links a:focus-visible,
      .icon-link:focus-visible {
        background: var(--accent-soft);
        color: var(--accent);
        border-color: var(--accent);
        outline: none;
      }
      .nav a.lang-toggle,
      .nav a.lang-toggle:hover,
      .nav a.lang-toggle:focus-visible {
        background: none;
        border-top: none;
        border-right: none;
        border-bottom: none;
        border-radius: 0;
        margin-left: 4px;
        padding: 2px 0 2px 16px;
      }
      .nav a.lang-toggle {
        border-left: 1px solid var(--line-strong);
        color: var(--muted);
      }
      .nav a.lang-toggle:hover,
      .nav a.lang-toggle:focus-visible {
        color: var(--accent);
        border-left-color: var(--line-strong);
      }
      .page { padding: 64px 0 96px; }
      .hero-card,
      .panel,
      .panel-primary,
      .panel-secondary {
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        background: var(--surface-raised);
      }
      .hero-card,
      .panel-primary {
        background: var(--surface-raised);
        box-shadow: var(--shadow);
      }
      .panel {
        background: var(--surface);
        box-shadow: var(--shadow-soft);
      }
      .panel-secondary {
        background: var(--surface-muted);
        box-shadow: none;
      }
      .hero-card {
        display: grid;
        grid-template-columns: minmax(0, 1.38fr) minmax(280px, 0.78fr);
        gap: 48px;
        padding: 56px;
        align-items: start;
      }

      .hero-copy {
        display: grid;
        align-content: start;
        gap: 16px;
      }
      .hero-side {
        display: grid;
        gap: 16px;
        align-content: start;
        padding-top: 8px;
      }
      .hero-facts-card,
      .hero-output-card,
      .evidence-strip {
        padding: 24px;
        border-radius: var(--radius-md);
        background: var(--surface);
        border: 1px solid var(--line);
      }
      .eyebrow {
        margin: 0;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .hero-copy h1 {
        margin: 4px 0 0;
        font-size: clamp(2.6rem, 5.5vw, 3.4rem);
        line-height: 1.15;
        font-weight: 700;
      }
      .headline {
        margin: 4px 0 0;
        font-size: clamp(1.1rem, 2vw, 1.28rem);
        color: var(--ink);
        max-width: 28ch;
        line-height: 1.55;
        font-weight: 500;
        white-space: pre-wrap;
      }
      .muted,
      .summary,
      .list p,
      .card p,
      li,
      .footer,
      .section-subtitle {
        color: var(--muted);
        line-height: 1.7;
      }
      .summary {
        margin: 0;
        font-size: 1.05rem;
        max-width: 65ch;
      }
      .summary-secondary {
        color: var(--faint);
        font-size: 0.96rem;
        max-width: 60ch;
      }
      .hero-links,
      .chip-row,
      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .hero-links {
        margin-top: 4px;
        align-items: center;
      }
      .hero-links a,
      .chip,
      .badge {
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        background: var(--surface);
        color: var(--body);
        border: 1px solid var(--line);
      }
      .hero-links a:hover,
      .badge:hover,
      .chip:hover {
        background: var(--accent-soft);
        color: var(--accent);
        border-color: var(--accent);
      }
      .hero-links a,
      .chip,
      .badge,
      .nav a,
      .footer-links a {
        font-size: 0.85rem;
        font-weight: 500;
      }
      .icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        padding: 0;
        color: var(--muted);
        background: var(--surface-raised);
        flex: 0 0 auto;
      }
      .icon-link:hover {
        color: var(--accent);
      }
      .icon-link-icon,
      .icon-link-icon svg {
        width: 18px;
        height: 18px;
        display: block;
        fill: currentColor;
      }
      .chip,
      .badge {
        font-size: 0.82rem;
        line-height: 1.4;
      }
      .badge-muted {
        background: var(--surface-raised);
        border-color: var(--line);
        color: var(--muted);
      }
      .hero-image-wrap {
        display: flex;
        align-items: flex-start;
        justify-content: center;
      }
      .hero-image {
        width: 100%;
        max-width: 180px;
        border-radius: var(--radius-md);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-soft);
        transform: scaleX(-1);
      }
      .hero-facts-list,
      .hero-output-list,
      .evidence-grid,
      .stats-grid,
      .card-grid,
      .feature-grid {
        display: grid;
        gap: 16px;
      }
      .hero-fact-item,
      .hero-output-item {
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }
      .hero-fact-item:first-child,
      .hero-output-item:first-child {
        padding-top: 0;
        border-top: none;
      }
      .hero-fact-label,
      .hero-output-year,
      .output-meta,
      .meta-label,
      .item-kicker {
        margin: 0 0 4px;
        color: var(--accent);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 600;
      }
      .hero-fact-value,
      .meta-value {
        margin: 0;
        color: var(--ink);
        line-height: 1.55;
        font-weight: 400;
      }
      .hero-output-item h3,
      .card h3,
      .card h4 {
        margin: 0 0 6px;
        font-size: 1.05rem;
        color: var(--ink);
        line-height: 1.4;
        font-weight: 600;
      }
      .hero-output-item p { margin: 0; }
      .grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
        margin-top: 40px;
      }
      .panel,
      .panel-primary,
      .panel-secondary { padding: 32px; }
      .span-8 { grid-column: span 8; }
      .span-7 { grid-column: span 7; }
      .span-6 { grid-column: span 6; }
      .span-5 { grid-column: span 5; }
      .span-4 { grid-column: span 4; }
      .span-12 { grid-column: span 12; }
      .section-title {
        margin: 0 0 8px;
        font-size: clamp(1.55rem, 2.4vw, 2rem);
        color: var(--ink);
        line-height: 1.25;
        font-weight: 700;
      }
      .section-subtitle {
        margin: 0;
        font-size: 0.95rem;
        max-width: 65ch;
      }
      .section-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 16px 24px;
        align-items: start;
        margin-bottom: 24px;
      }
      .section-header > :first-child {
        min-width: 0;
      }
      .list { display: grid; gap: 16px; }
      .card {
        padding: 20px 0;
        border-top: 1px solid var(--line);
      }
      .card:first-child {
        border-top: none;
        padding-top: 0;
      }
      .divider-top {
        border-top: 1px solid var(--line);
        padding-top: 16px;
      }
      .footer {
        padding: 32px 0 48px;
        font-size: 0.9rem;
        border-top: 1px solid var(--line-strong);
      }
      .footer-grid {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
      }
      .footer-copy p { margin: 0; }
      .footer-copy p + p { margin-top: 6px; }
      .footer-icp {
        color: var(--faint);
        font-size: 0.85rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }
      @media (max-width: 960px) {
        .hero-card {
          grid-template-columns: 1fr;
          gap: 32px;
          padding: 40px;
        }
        .section-header {
          grid-template-columns: 1fr;
        }
        .span-8,
        .span-7,
        .span-6,
        .span-5,
        .span-4 {
          grid-column: span 12;
        }
        .site-header,
        .footer-grid {
          flex-direction: column;
          align-items: flex-start;
        }
        .nav,
        .footer-links {
          justify-content: flex-start;
        }
        .grid {
          gap: 24px;
        }
        .panel,
        .panel-primary,
        .panel-secondary {
          padding: 24px;
        }
      }
      @media (max-width: 720px) {
        .shell { padding: 20px; }
        .page { padding: 40px 0 64px; }
        .hero-card,
        .panel,
        .panel-primary,
        .panel-secondary { padding: 24px; }
        .hero-copy {
          gap: 16px;
        }
        .hero-copy h1 { font-size: clamp(2.1rem, 10vw, 2.8rem); }
        .hero-links,
        .chip-row,
        .meta-row {
          gap: 8px;
        }
        .grid {
          margin-top: 24px;
          gap: 20px;
        }
      }
      @page {
        size: A4;
        margin: 16mm;
      }
      @media print {
        .site-header,
        .nav,
        .lang-toggle,
        .footer {
          display: none !important;
        }
        .shell {
          max-width: none;
          padding: 0;
        }
        .page {
          padding: 0;
        }
        body {
          color: #000;
          font-size: 12pt;
          background: #fff;
        }
        .hero-card,
        .panel,
        .panel-primary,
        .panel-secondary {
          box-shadow: none;
          border-color: var(--line-strong);
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="brand">
          <h1>{t(profile.name, lang)}</h1>
          <p>{t(brandSubtitle, lang)}</p>
        </div>
        <nav class="nav">
          {navigation.map((item) => (
            <a href={localizedPath(item.href, lang)}>{t(item.label, lang)}</a>
          ))}
          <a href={localizedPath(portfolioHref, lang)}>Portfolio</a>
          {showLangToggle && (
            <a class="lang-toggle" href={toggleHref} hreflang={toggleLang === 'zh' ? 'zh-CN' : 'en'}>{toggleLabel}</a>
          )}
        </nav>
      </header>
      <main class="page">
        <slot />
      </main>
      <footer class="footer">
        <div class="footer-grid">
          <div class="footer-copy">
            <p>Copyright © 2026 LIU HONG</p>
            {showIcp && <p class="footer-icp">{icpText}</p>}
          </div>
          <div class="footer-links">
            <a href={localizedPath(portfolioHref, lang)}>Portfolio</a>
            {profile.links.map((link) => (
              <a class="icon-link" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
                <span class="icon-link-icon" set:html={`<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${iconMap[link.icon]}</svg>`} />
              </a>
            ))}
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
